# Dependency directories
node_modules/
.pnp/
.pnp.js

# Production & Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
backend/tsconfig.tsbuildinfo

# Environment & Secrets (NEVER commit secrets or real credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Always preserve example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example
!.env.*.example

# Testing & Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

