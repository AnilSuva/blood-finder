NODE_ENV=development
PORT=4001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blood-finder
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
COOKIE_DOMAIN=localhost

# Generated 64-character (32-byte hex) cryptographic secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters

# Token and OTP policies
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email / SMTP Settings (Optional in dev, defaults to mock jsonTransport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BloodFinder <no-reply@example.com>"

# Cloudflare Turnstile CAPTCHA (Optional in local dev)
TURNSTILE_SECRET_KEY=

# Business Logic & Rate Limiting
REQUEST_EXPIRY_HOURS=48
MAX_ACTIVE_REQUESTS_PER_USER=3
DEFAULT_COUNTRY_CODE=+91
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
